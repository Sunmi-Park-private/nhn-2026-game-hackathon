{
  "name": "red-horse-rescue",
  "version": "0.0.1",
  "description": "Red Horse Rescue 2026 — Reigns식 스와이프 + 로그라이크 아이돌 게임",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite",
    "share": "npm run build && vite preview --host --port 5174 --strictPort",
    "tunnel": "cloudflared tunnel --url http://localhost:5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:single": "tsc --noEmit && VITE_CHEATS=1 vite build --config vite.single.config.ts && node scripts/singlefile.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "playwright-core": "^1.61.1",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  }
}
